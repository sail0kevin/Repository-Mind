# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/
.pytype/

# Virtual environments
.venv/
.venv-build/
venv/
env/
.env
.env.*
!.env.example

# Local data / databases
# 数据库、迁移备份和 SQLite 侧车文件可能包含用户仓库、证据、问答和 Trace，禁止上传。
/data/
/backend/tests/.tmp/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.db-journal
*.db-wal
*.db-shm
# 如果未来需要提交人工构造的数据库安全夹具，可放在 fixtures 下并显式追踪。
!backend/tests/fixtures/**/*.sqlite
!backend/tests/fixtures/**/*.sqlite3
!backend/tests/fixtures/**/*.db

# Build artifacts
/backend-build/
/backend-dist/
/localpyc/
/desktop/app/release/
/desktop/app/dist-electron/
/desktop/app/dist-renderer/
# Inno Setup 编译时会在 .iss 同目录生成 Languages\*.isl 临时语言文件，属构建产物
installer/Languages/
installer-output/
/release-web-local/

# Node / frontend
node_modules/
.npm
.yarn/
.pnpm-debug.log*
.next/
out/
.vite/
.vitest/
*.tsbuildinfo
*.log

# RepoMind runtime artifacts
logs/
tmp/
*.log
/desktop/app/test-results/
/desktop/app/playwright-report/
/e2e-artifacts/
/backend/e2e-artifacts/
/benchmark-runs/

# Historical documents are versioned for decision traceability. They are not
# current implementation guidance; see docs/README.md for the active entrypoints.

# Sensitive key and certificate material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# 安全测试夹具必须是人工构造且不含真实凭据，必要时可在 fixtures 下显式追踪。
!backend/tests/fixtures/**/*.pem
!backend/tests/fixtures/**/*.key
!backend/tests/fixtures/**/*.p12
!backend/tests/fixtures/**/*.pfx
secrets.json
secrets.json.tmp
# 基准测试用的本地 Embedding Key 文件，仅存在于本机，禁止提交。
bench-embedding.local.json

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Tooling state
.claude/

# Portable distribution
RepoMindPortable/
*.exe

# Local audit / test workspaces (内部评测与临时数据，禁止提交)
# 这些目录含冻结索引、数据库备份、Codex 本地配置与审计 JSON，绝不能进公开仓库。
.tmp-*/
.test-*/
scripts/_tmp_*
backend/.test-tmp-codex-*/
backend/service/mcp_server/.tools-*.tmp.py

# SQLite 备份与校验快照：`*.sqlite3` 只匹配以 .sqlite3 结尾的文件，
# 以下后缀（.backup-... / .VERIFIED-...）会漏网，需单独覆盖。
*.sqlite3.*
*sqlite3.backup*
*sqlite3.VERIFIED*
